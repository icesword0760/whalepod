{
  "name": "dsh-plugin-matou-layout",
  "version": "0.0.0",
  "description": "A Matou-parity conversation workspace for DeepSeek Harness, forked from the official ui-layout plugin",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "setup:dev": "bash scripts/setup-dev-env.sh",
    "check:dev": "bash -c 'source .dev-env && pnpm run check'",
    "build": "tsdown --config tsdown.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p tsconfig.client.json --emitDeclarationOnly",
    "deps:check": "pnpm install --frozen-lockfile && pnpm peers check",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "pnpm run build && vitest run",
    "check": "pnpm run typecheck && pnpm run test",
    "pack:check": "pnpm pack --pack-destination .artifacts",
    "desktop": "node --import ../deepseek-harness/node_modules/tsx/dist/loader.mjs scripts/desktop.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.5-rc.0 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.0 <0.2.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.0 <0.2.0",
    "@deepseek-ai/dsh-mcp-client": "^0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-api-gateway": "link:../deepseek-harness/packages/api/gateway",
    "@deepseek-ai/dsh-api-session-controller": "link:../deepseek-harness/packages/api/session-controller",
    "@deepseek-ai/dsh-api-workspace-controller": "link:../deepseek-harness/packages/api/workspace-controller",
    "@deepseek-ai/dsh-client-locale": "link:../deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-store": "link:../deepseek-harness/packages/client/store",
    "@deepseek-ai/dsh-client-test-runtime": "link:../deepseek-harness/packages/test-support/client-runtime",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-layout": "link:../deepseek-harness/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../deepseek-harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-session": "link:../deepseek-harness/packages/client/ui-session",
    "@deepseek-ai/dsh-client-ui-sidebar": "link:../deepseek-harness/packages/client/ui-sidebar",
    "@deepseek-ai/dsh-client-ui-slots": "link:../deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-theme": "link:../deepseek-harness/packages/client/ui-theme",
    "@deepseek-ai/dsh-client-ui-workspace": "link:../deepseek-harness/packages/client/ui-workspace",
    "@deepseek-ai/dsh-session": "link:../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-session-query": "link:../deepseek-harness/packages/session-query/session-query",
    "@deepseek-ai/dsh-storage": "link:../deepseek-harness/packages/storage/storage",
    "@deepseek-ai/dsh-storage-domain": "link:../deepseek-harness/packages/storage/storage-domain",
    "@deepseek-ai/dsh-storage-json": "link:../deepseek-harness/packages/storage/storage-json",
    "@deepseek-ai/dsh-tools": "link:../deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-typert-protocol": "link:../deepseek-harness/packages/typert/protocol",
    "@deepseek-ai/dsh-user-approval": "link:../deepseek-harness/packages/interaction/user-approval",
    "@deepseek-ai/dsh-util-workspace-path": "link:../deepseek-harness/packages/util/workspace-path",
    "@deepseek-ai/dsh-workspace": "link:../deepseek-harness/packages/workspace/workspace",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "clsx": "^2.0.0",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.30.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "unrun": "0.3.1",
    "use-sync-external-store": "1.2.0",
    "vitest": "4.1.8",
    "yaml": "^2.9.0",
    "zod": "4.4.3",
    "@deepseek-ai/dsh-skill": "link:../deepseek-harness/packages/skill/skill",
    "@deepseek-ai/dsh-mcp-client": "link:../deepseek-harness/packages/mcp/mcp-client",
    "@deepseek-ai/dsh-system-prompt": "link:../deepseek-harness/packages/core/system-prompt"
  },
  "packageManager": "pnpm@11.7.0"
}
