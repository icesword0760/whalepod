+it('does not guess for PAC, disabled or invalid proxies', () => {
+ expect(environmentWithSystemProxy({}, config + '\nProxyAutoConfigEnable : 1')).toEqual({})
+ expect(environmentWithSystemProxy({}, config.replaceAll('Enable : 1', 'Enable : 0'))).toEqual({})
+ expect(environmentWithSystemProxy({}, config.replaceAll('7897', '99999'))).toEqual({})
