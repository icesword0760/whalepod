@@ -0,0 +1,19 @@
+/** Split native directory references from uploadable browser files synchronously during drop. */
+export function splitDroppedFiles(transfer: DataTransfer, pathForFile?: (file: File) => string) {
+  const files: File[] = []
+  const directories: string[] = []
+  const unsupported: string[] = []
+  const items = Array.from(transfer.items ?? []).filter(item => item.kind === 'file')
+  if (items.length === 0) return { files: Array.from(transfer.files), directories, unsupported }
+  for (const item of items) {
+    const entry = item.webkitGetAsEntry?.()
+    const file = item.getAsFile()
+    if (entry?.isDirectory) {
+      let path = ''
+      try { if (file) path = pathForFile?.(file) ?? '' } catch { /* Never upload a directory as fallback. */ }
+      if (path.startsWith('/') || /^[A-Za-z]:[\\/]/.test(path)) directories.push(path)
+      else unsupported.push(entry.name)
+    } else if (file) files.push(file)
+  }
+  return { files, directories: [...new Set(directories)], unsupported }
+}
