+/** Accept only ordinary website links for the system browser, never local or app schemes. */
+export function externalWebsite(value: string): string | undefined {
+  try {
+    const url = new URL(value)
+    if (!['http:', 'https:'].includes(url.protocol) || !url.hostname || url.username || url.password) return undefined
+    return url.href
+  } catch { return undefined }
+}
diff --git a/apps/desktop/src/system-proxy.ts b/apps/desktop/src/system-proxy.ts
new file mode 100644
index 0000000000..3ccd184628
--- /dev/null
+++ b/apps/desktop/src/system-proxy.ts
@@ -0,0 +1,47 @@
+/** Bridge macOS's existing manual HTTP proxy to the bundled Node Host. */
+import { execFile } from 'node:child_process'
+import { promisify } from 'node:util'
+
+const run = promisify(execFile)
+const explicitProxyNames = ['http_proxy', 'HTTP_PROXY', 'https_proxy', 'HTTPS_PROXY', 'all_proxy', 'ALL_PROXY']
+
+/** Preserve explicit launch overrides; inherit only enabled manual system proxies. */
+export function environmentWithSystemProxy(env: NodeJS.ProcessEnv, configuration: string): NodeJS.ProcessEnv {
+  if (explicitProxyNames.some(name => env[name] !== undefined)) return { ...env }
+  const value = (key: string): string | undefined =>
+    new RegExp('^\\s*' + key + '\\s*:\\s*(.*?)\\s*$', 'm').exec(configuration)?.[1]
+  // PAC rules are destination-specific; never turn them into a process-wide proxy.
+  if (value('ProxyAutoConfigEnable') === '1' || value('ProxyAutoDiscoveryEnable') === '1') return { ...env }
+  const result = { ...env }
+  for (const [prefix, name] of [['HTTP', 'HTTP_PROXY'], ['HTTPS', 'HTTPS_PROXY']] as const) {
+    if (value(prefix + 'Enable') !== '1') continue
+    const host = value(prefix + 'Proxy')
+    const port = Number(value(prefix + 'Port'))
+    if (!host || !/^[a-zA-Z0-9.:[\]-]+$/.test(host) || !Number.isInteger(port) || port < 1 || port > 65535) continue
+    const authority = host.includes(':') && !host.startsWith('[') ? '[' + host + ']' : host
+    result[name] = 'http://' + authority + ':' + port
+  }
+  if (!result.HTTP_PROXY && !result.HTTPS_PROXY) return result
+  const exceptions = /ExceptionsList\s*:\s*<array>\s*{([^}]*)}/.exec(configuration)?.[1] ?? ''
+  // The shared policy supports host suffixes, not CIDR rules. Private IP literals
+  // remain blocked by WebFetch's existing validation, irrespective of proxy use.
+  const names = [...exceptions.matchAll(/^\s*\d+\s*:\s*(\S+)\s*$/gm)]
+    .map(match => match[1]!)
+    .filter(name => /^[a-zA-Z0-9.*_-]+$/.test(name))
+  const bypass = [env.no_proxy ?? env.NO_PROXY ?? '', ...names, 'localhost', '127.0.0.1', '::1'].filter(Boolean).join(',')
+  result.NO_PROXY = bypass
+  result.no_proxy = bypass
+  return result
+}
+
+/** Read-only, bounded discovery; unsupported systems keep their launch environment. */
+export async function desktopHostEnvironment(env: NodeJS.ProcessEnv): Promise<NodeJS.ProcessEnv> {
+  if (process.platform !== 'darwin' || explicitProxyNames.some(name => env[name] !== undefined)) return { ...env }
+  try {
+    const { stdout } = await run('/usr/sbin/scutil', ['--proxy'], { timeout: 2000, maxBuffer: 65536 })
+    return environmentWithSystemProxy(env, stdout)
+  } catch {
+    // Proxy discovery must not turn an otherwise healthy desktop into a startup failure.
+    return { ...env }
+  }
+}
