+const config = `<dictionary> {
+ HTTPEnable : 1
+ HTTPPort : 7897
+ HTTPProxy : 127.0.0.1
+ HTTPSEnable : 1
+ HTTPSPort : 7897
+ HTTPSProxy : 127.0.0.1
+ ExceptionsList : <array> {
+  0 : localhost
+  1 : *.local
+  2 : 192.168.0.0/16
+ }
+}`
+it('passes enabled manual proxies to Node without mutating the launch environment', () => {
+ const env = { PATH: '/bin', NO_PROXY: 'example.com' }
+ const result = environmentWithSystemProxy(env, config)
+ expect(result.HTTP_PROXY).toBe('http://127.0.0.1:7897')
+ expect(result.HTTPS_PROXY).toBe(result.HTTP_PROXY)
+ expect(result.NO_PROXY).toContain('example.com')
+ expect(result.NO_PROXY).toContain('*.local')
+ expect(result.NO_PROXY).not.toContain('/16')
+ expect(env).toEqual({ PATH: '/bin', NO_PROXY: 'example.com' })
