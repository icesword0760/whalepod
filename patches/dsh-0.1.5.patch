+// @vitest-environment jsdom
+import { afterEach, expect, it, vi } from 'vitest'
+import { cleanup, render, act } from '@testing-library/react'
+import { useRef } from 'react'
+import { menuMaxHeight, useMenuMaxHeight } from '../src/client/useMenuMaxHeight.ts'
+afterEach(() => { cleanup(); document.body.innerHTML = ''; vi.restoreAllMocks(); vi.unstubAllGlobals() })
+it.each(['hidden', 'auto', 'scroll', 'clip'])('fits within a card with overflow %s rather than only the window', overflow => {
+  const card = document.createElement('div'); card.style.overflowY = overflow
+  const menu = card.appendChild(document.createElement('div')); document.body.append(card)
+  vi.spyOn(card, 'getBoundingClientRect').mockReturnValue({ top: 80 } as DOMRect)
+  vi.spyOn(menu, 'getBoundingClientRect').mockReturnValue({ bottom: 400 } as DOMRect)
+  expect(menuMaxHeight(menu, 400)).toBe(312)
+  vi.spyOn(menu, 'getBoundingClientRect').mockReturnValue({ bottom: 70 } as DOMRect)
+  expect(menuMaxHeight(menu, 400)).toBe(0)
+})
+it('respects nested clipping, but ignores an unclipped composer', () => {
+  const outer = document.createElement('div'); outer.style.overflow = 'hidden'
+  const inner = outer.appendChild(document.createElement('div')); inner.style.overflow = 'auto'
+  const composer = inner.appendChild(document.createElement('div'))
+  const menu = composer.appendChild(document.createElement('div')); document.body.append(outer)
+  for (const [element, top] of [[outer, 40], [inner, 90], [composer, 400]] as const) vi.spyOn(element, 'getBoundingClientRect').mockReturnValue({ top } as DOMRect)
+  vi.spyOn(menu, 'getBoundingClientRect').mockReturnValue({ bottom: 400 } as DOMRect)
+  expect(menuMaxHeight(menu, 400)).toBe(302)
+})
+it('refits on container resize and disconnects observers on close', () => {
+  let resized: () => void = () => {}
+  const disconnect = vi.fn()
+  vi.stubGlobal('ResizeObserver', class { constructor(fn: () => void) { resized = fn } observe() {} disconnect = disconnect })
+  let top = 80
+  vi.spyOn(Element.prototype, 'getBoundingClientRect').mockImplementation(function(this: Element) { return { top: this.id === 'card' ? top : 0, bottom: 400 } as DOMRect })
+  function Fixture() { const ref = useRef<HTMLDivElement>(null); const height = useMenuMaxHeight(ref, 400, true); return <div id="card" style={{ overflow: 'hidden' }}><div ref={ref} data-testid="menu" style={{ maxHeight: height }} /></div> }
+  const view = render(<Fixture />)
+  expect(view.getByTestId('menu').style.maxHeight).toBe('312px')
+  top = 200; act(() => { resized() })
+  expect(view.getByTestId('menu').style.maxHeight).toBe('192px')
+  view.unmount(); expect(disconnect).toHaveBeenCalled()
+})
