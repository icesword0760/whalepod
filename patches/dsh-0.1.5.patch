+// @vitest-environment jsdom
+import { cleanup, fireEvent, render, waitFor } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+import { MarkdownText } from './markdown-test-components.tsx'
+afterEach(cleanup)
+it('keeps left-click preview and reveals only after explicit context-menu selection', async () => {
+  const open = vi.fn()
+  const reveal = vi.fn().mockResolvedValue(undefined)
+  const view = render(<MarkdownText text={'`report.md`'} fileMentions={{ resolve: () => ({
+    open, reveal, title: '/work/report.md', label: 'Preview', revealLabel: 'Show in Finder', revealError: 'Try again',
+  }) }} />)
+  fireEvent.click(view.getByRole('button', { name: 'Preview' }))
+  expect(open).toHaveBeenCalledTimes(1)
+  fireEvent.contextMenu(view.getByRole('button', { name: 'Preview' }))
+  expect(reveal).not.toHaveBeenCalled()
+  fireEvent.click(view.getByRole('menuitem', { name: 'Show in Finder' }))
+  await waitFor(() => expect(reveal).toHaveBeenCalledTimes(1))
+})
+it('reports native failure and allows retry', async () => {
+  const reveal = vi.fn().mockRejectedValueOnce(new Error('missing')).mockResolvedValue(undefined)
+  const view = render(<MarkdownText text={'`report.md`'} fileMentions={{ resolve: () => ({
+    open: () => {}, reveal, title: '/work/report.md', label: 'Preview', revealLabel: 'Show in Finder', revealError: 'Try again',
+  }) }} />)
+  fireEvent.contextMenu(view.getByRole('button', { name: 'Preview' }))
+  fireEvent.click(view.getByRole('menuitem', { name: 'Show in Finder' }))
+  await waitFor(() => expect(view.getByRole('alert').textContent).toBe('Try again'))
+  fireEvent.contextMenu(view.getByRole('button', { name: 'Preview' }))
+  fireEvent.click(view.getByRole('menuitem', { name: 'Show in Finder' }))
+  await waitFor(() => expect(view.queryByRole('alert')).toBeNull())
+})
